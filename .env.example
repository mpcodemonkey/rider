# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Bot token from your Fluxer instance's developer portal.
FLUXER_TOKEN=

# Base API URL. Leave unset for fluxer.app; point it at your own instance
# when self-hosting, e.g. https://fluxer.example.com/api/v1
#FLUXER_API_URL=

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
# Jockie's default. Matching is case-insensitive, so M! works too.
BOT_PREFIX=m!
# Extra prefixes, comma separated. Handy when running several instances
# (Jockie style: mm! for the second bot, mmm! for the third).
#BOT_EXTRA_PREFIXES=!,-
BOT_RESPOND_TO_MENTION=true

# ---------------------------------------------------------------------------
# Playback
# ---------------------------------------------------------------------------
DEFAULT_VOLUME=100
MAX_VOLUME=200
MAX_QUEUE_SIZE=5000
# Seconds to wait before leaving an idle channel. 0 disables it.
IDLE_TIMEOUT=300
# Seconds to wait before leaving a channel with no listeners. 0 disables it.
EMPTY_CHANNEL_TIMEOUT=60
ANNOUNCE_NOW_PLAYING=true

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------
# ytsearch (YouTube) or scsearch (SoundCloud).
SEARCH_PROVIDER=ytsearch
YTDLP_FORMAT=bestaudio/best
# Max tracks pulled from one playlist/album.
PLAYLIST_LIMIT=500
# Netscape-format cookie file. Helps with age-gated videos and bot checks.
# Only takes effect for a client that honors cookies (see YTDLP_PLAYER_CLIENTS
# below) - export with a browser extension like "Get cookies.txt LOCALLY",
# logged into a real Google account, and refresh it if it stops working.
#YTDLP_COOKIEFILE=/config/cookies.txt
#YTDLP_PROXY=http://proxy:8080
# Which YouTube client(s) yt-dlp pretends to be, tried in order, comma
# separated. This matters for cookies: 'web' and 'tv' send them along,
# 'android'/'mweb'/'ios' silently ignore any cookiefile and increasingly
# need a PO token this bot doesn't provide. If YouTube starts blocking the
# default below, check the yt-dlp README/issues for the current workaround
# and adjust this - no code change needed.
YTDLP_PLAYER_CLIENTS=web,tv

# Spotify links are resolved to metadata and then played from YouTube.
# Create an app at https://developer.spotify.com/dashboard
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=

# Allow playing files from the bot's own filesystem. Only enable this if you
# trust everyone who can run commands — it exposes the bot's local disk.
ALLOW_LOCAL_FILES=false

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
DATABASE_PATH=data/jockiefluxer.db
LOG_LEVEL=INFO
